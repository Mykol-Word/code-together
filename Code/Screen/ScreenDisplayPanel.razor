@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Threading.Tasks;
@inherits PanelComponent

<root>
	<div class="screen">
		@if ( !_connected )
		{
			<div class="no-stream">no stream websocket found</div>
		}
		<label class="stop-btn" onclick="@OnStopStreamingClick">stop streaming</label>
	</div>
</root>

@code
{
	[Property] public string ConnectionUri { get; set; } = "ws://localhost:8080";
	[Property] public float RetryInterval { get; set; } = 3f;

	public WebSocket Socket { get; private set; }

	private const string STREAMER_ACHIEVEMENT = "streamer";

	[Sync] private bool _connected { get; set; }

	private Texture _texture;
	private Bitmap _bitmap;
	private TimeUntil _next_attempt;
	private bool _connecting;
	private bool _warned;

	protected override void OnEnabled()
	{
		if ( IsProxy ) return;

		_next_attempt = 0f;
		_warned = false;
	}

	protected override void OnDisabled()
	{
		if ( IsProxy ) return;

		DropSocket();
		_connected = false;
	}

	protected override void OnDestroy()
	{
		Socket?.Dispose();
		_bitmap?.Dispose();
	}

	// retries the connection whenever it isnt established
	protected override void OnUpdate()
	{
		if ( IsProxy ) return;
		if ( _connected || _connecting ) return;
		if ( !_next_attempt ) return;

		_ = Connect();
	}

	private async Task Connect()
	{
		_connecting = true;

		DropSocket();
		Socket = new WebSocket(500000); // 500 KB limit
		Socket.OnDataReceived += OnFrame;
		Socket.OnDisconnected += OnSocketDisconnected;

		try
		{
			await Socket.Connect( ConnectionUri );
			_connected = true;
			_warned = false;
			Sandbox.Services.Achievements.Unlock( STREAMER_ACHIEVEMENT );
		}
		catch ( Exception e )
		{
			if ( !_warned )
				Log.Warning( $"failed to connect: {e.Message}" );

			_warned = true;
			_next_attempt = RetryInterval;
		}

		_connecting = false;
	}

	// flags the stream as down and schedules a reconnect attempt
	private void OnSocketDisconnected( int status, string reason )
	{
		_connected = false;
		_next_attempt = RetryInterval;
	}

	// tears down the current socket and its subscriptions
	private void DropSocket()
	{
		if ( Socket is null ) return;

		Socket.OnDataReceived -= OnFrame;
		Socket.OnDisconnected -= OnSocketDisconnected;
		Socket.Dispose();
		Socket = null;
	}

	private void OnFrame( Span<byte> data )
	{
		ApplyFrame( data.ToArray() );
	}

	[Rpc.Broadcast( NetFlags.SendImmediate )]
	private void ApplyFrame( byte[] jpeg )
	{
		var screen = Panel?.GetChild( 0 );
		if ( screen is null ) return;

		var bitmap = Bitmap.CreateFromBytes( jpeg );

		_bitmap?.Dispose();
		_bitmap = bitmap;

		_texture = Texture.Create( _bitmap.Width, _bitmap.Height ).Finish();
		screen.Style.SetBackgroundImage( _texture );

		_texture.Update( _bitmap );
	}

	void OnStopStreamingClick()
	{
		if ( IsProxy ) return;
		StopStreaming();
	}

	[Rpc.Broadcast]
	void StopStreaming()
	{
		GetComponent<MonitorPanel>( true ).Enabled = true;
		Enabled = false;
	}

	protected override int BuildHash() => System.HashCode.Combine( _connected );
}
