@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Threading.Tasks;
@inherits PanelComponent

<root>
	<div class="screen">
		@if ( !_connected )
		{
			<div class="no-stream">no stream websocket found</div>
		}
		<label class="stop-btn" onclick="@OnStopStreamingClick">stop streaming</label>
	</div>
</root>

@code
{
	[Property] public string ConnectionUri { get; set; } = "ws://localhost:8080";

	public WebSocket Socket { get; private set; }

	[Sync] private bool _connected { get; set; }

	private Texture _texture;
	private Bitmap _bitmap;

	protected override void OnEnabled()
	{
		if ( IsProxy ) return;

		Socket = new WebSocket(500000); // 500 KB limit
		Socket.OnMessageReceived += OnFrame;
		_ = Connect();
	}

	protected override void OnDisabled()
	{
		if ( IsProxy ) return;

		Socket?.Dispose();
		Socket = null;
		_connected = false;
	}

	protected override void OnDestroy()
	{
		Socket?.Dispose();
		_bitmap?.Dispose();
	}

	private async Task Connect()
	{
		try
		{
			await Socket.Connect( ConnectionUri );
			_connected = true;
		}
		catch ( Exception e )
		{
			Log.Error( $"failed to connect: {e.Message}" );
		}
	}

	private void OnFrame( string message )
	{
		ApplyFrame( message );
	}

	[Rpc.Broadcast( NetFlags.SendImmediate )]
	private void ApplyFrame( string base64 )
	{
		var bytes = Convert.FromBase64String( base64 );
		var bitmap = Bitmap.CreateFromBytes( bytes );

		_bitmap?.Dispose();
		_bitmap = bitmap;

		_texture = Texture.Create( _bitmap.Width, _bitmap.Height ).Finish();
		Panel.GetChild( 0 ).Style.SetBackgroundImage( _texture );

		_texture.Update( _bitmap );
	}

	void OnStopStreamingClick()
	{
		if ( IsProxy ) return;
		StopStreaming();
	}

	[Rpc.Broadcast]
	void StopStreaming()
	{
		GetComponent<MonitorPanel>( true ).Enabled = true;
		Enabled = false;
	}

	protected override int BuildHash() => System.HashCode.Combine( _connected );
}
