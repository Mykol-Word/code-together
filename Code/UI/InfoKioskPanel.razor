@namespace Sandbox
@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="screen">
		<label class="title">INFO KIOSK</label>

		<div class="section">
			<label class="heading">Controls</label>
			<div class="control-line"><label class="control-name">sit in chair</label><label class="arrow">-&gt;</label><label class="key">E</label></div>
			<div class="control-line"><label class="control-name">move in chair</label><label class="arrow">-&gt;</label><label class="key">WASD</label></div>
			<div class="control-line"><label class="control-name">rotate chair</label><label class="arrow">-&gt;</label><label class="key">Q + R</label></div>
			<div class="control-line"><label class="control-name">unlock mouse</label><label class="arrow">-&gt;</label><label class="key">TAB</label></div>
		</div>

		<div class="section">
			<label class="heading">Streaming Modes</label>
			<label class="line">- Stream Screen <span class="note">(external tool GitHub link in game description)</span></label>
			<label class="line">- Youtube Video</label>
			<label class="line">- Whiteboard</label>
		</div>

		<div class="section">
			<label class="heading">Special Thanks</label>
			<label class="line">- Blue Shrimp: testing</label>
			<label class="line">- Gibbard: youtube + whiteboard suggestion</label>
			<label class="line">- JOELwindows7: various suggestions</label>
		</div>
	</div>
</root>

@code
{
	protected override int BuildHash() => 0;
}
